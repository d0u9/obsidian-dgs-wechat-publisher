{
  "name": "obsidian-dgs-wechat-publisher",
  "version": "0.1.5",
  "description": "Create WeChat Official Account drafts from Obsidian notes.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "npm run build && npm run deploy",
    "lint": "eslint src"
  },
  "dependencies": {
    "dgs-wechat-publisher": "github:d0u9/dgs-wechat-publisher#7d806e4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  }
}
